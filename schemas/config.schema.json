{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Adamkadaban/crucible/schemas/config.schema.json",
  "title": "Crucible configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "vm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "default": "crucible-win11" },
        "cpus": { "type": "integer", "minimum": 1, "default": 4 },
        "memoryMiB": { "type": "integer", "minimum": 2048, "default": 8192 },
        "diskGiB": { "type": "integer", "minimum": 40, "default": 128 },
        "display": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "type": "string", "enum": ["none", "gtk", "vnc"], "default": "none" },
            "vncSocketPath": { "type": "string", "minLength": 1, "default": "artifacts/vnc.sock" }
          }
        },
        "extraQemuArgs": { "type": "array", "items": { "type": "string" }, "default": [] }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cacheDir": { "type": "string", "minLength": 1, "default": "media/cache" },
        "profile": {
          "type": "string",
          "enum": ["windows11-enterprise-eval", "windows-server-2025-eval"],
          "default": "windows11-enterprise-eval"
        },
        "windowsIso": { "$ref": "#/$defs/isoMediaOverride" },
        "virtioIso": { "$ref": "#/$defs/isoMediaOverride" },
        "driverBundle": { "$ref": "#/$defs/driverBundleOverride" }
      }
    },
    "virtio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "diskBus": {
          "type": "string",
          "enum": ["virtio-blk", "virtio-scsi"],
          "default": "virtio-scsi"
        },
        "networkDevice": {
          "type": "string",
          "enum": ["virtio-net-pci"],
          "default": "virtio-net-pci"
        },
        "balloon": { "type": "boolean", "default": true },
        "rng": { "type": "boolean", "default": true }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["isolated", "nat", "capture"], "default": "isolated" },
        "pcapPath": {
          "type": "string",
          "minLength": 1,
          "description": "Optional pcap output path honored only in capture mode."
        },
        "tlsKeyLogPath": {
          "type": "string",
          "minLength": 1,
          "description": "Optional TLS key log file associated with capture-mode pcaps. Sensitive; keep under ignored artifacts."
        },
        "controlPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 8443,
          "description": "Guest API port reachable only through the host control network."
        }
      }
    },
    "analysisPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "isolatedAnalysisVm": { "const": true, "default": true },
        "disableDefender": { "type": "boolean", "default": true },
        "disableCodeIntegrity": { "type": "boolean", "default": true },
        "requireTestSigningDisabled": { "const": true, "default": true },
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hostname": { "type": "string", "minLength": 1 },
            "username": { "type": "string", "minLength": 1 },
            "locale": { "type": "string", "minLength": 1, "default": "en-US" },
            "screenSize": {
              "type": "string",
              "pattern": "^\\d{3,5}x\\d{3,5}$",
              "default": "1920x1080"
            },
            "disableSleep": { "type": "boolean", "default": true },
            "showFileExtensions": { "type": "boolean", "default": true },
            "showHiddenFiles": { "type": "boolean", "default": true },
            "showExplorerRibbon": { "type": "boolean", "default": true },
            "clearRecentExplorerHistory": { "type": "boolean", "default": true },
            "commonAnalysisLabCamouflage": { "type": "boolean", "default": false }
          }
        }
      }
    },
    "realism": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional seeded persona/camouflage profile for making provisioned guests look less like default sandboxes. Does not make QEMU/KVM undetectable.",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "seed": { "type": "string", "minLength": 1 },
        "profile": {
          "type": "string",
          "enum": ["minimal", "office-user", "developer", "student", "home-user"],
          "default": "office-user"
        },
        "hostname": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,13}[A-Za-z0-9])?$" },
        "adminUsername": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,19}$" },
        "userUsername": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,19}$" },
        "fullName": { "type": "string", "minLength": 1 },
        "locale": { "type": "string", "minLength": 1 },
        "timezone": { "type": "string", "minLength": 1 },
        "keyboardLayout": { "type": "string", "minLength": 1 },
        "screenResolution": {
          "type": "string",
          "pattern": "^\\d{3,5}x\\d{3,5}$",
          "description": "Persona metadata only; display settings are not applied in the guest yet."
        },
        "installCommonSoftware": { "type": "boolean", "default": false },
        "populateUserFiles": { "type": "boolean", "default": true },
        "simulateUserHistory": { "type": "boolean", "default": false },
        "randomizeInstallTimes": { "type": "boolean", "default": true }
      }
    },
    "qmp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "socketPath": { "type": "string", "minLength": 1, "default": "artifacts/qmp.sock" },
        "timeoutMs": { "type": "integer", "minimum": 100, "default": 5000 }
      }
    },
    "qga": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "socketPath": { "type": "string", "minLength": 1, "default": "artifacts/qga.sock" },
        "timeoutMs": { "type": "integer", "minimum": 100, "default": 10000 }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "directory": { "type": "string", "minLength": 1, "default": "artifacts" },
        "manifestPath": { "type": "string", "minLength": 1, "default": "artifacts/manifest.json" },
        "logsDirectory": { "type": "string", "minLength": 1, "default": "artifacts/logs" },
        "snapshotsDirectory": { "type": "string", "minLength": 1, "default": "snapshots" },
        "secretsDirectory": { "type": "string", "minLength": 1, "default": "secrets" }
      }
    }
  },
  "$defs": {
    "isoMediaOverride": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [{ "required": ["path"] }, { "required": ["url"] }],
      "properties": {
        "path": { "type": "string", "minLength": 1, "pattern": "\\.[iI][sS][oO]$" },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "\\.[iI][sS][oO](?:[?#].*)?$"
        },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
      }
    },
    "driverBundleOverride": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [{ "required": ["path"] }, { "required": ["url"] }],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\.(?:[iI][sS][oO]|[eE][xX][eE]|[zZ][iI][pP]|[mM][sS][iI])$"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "\\.(?:[iI][sS][oO]|[eE][xX][eE]|[zZ][iI][pP]|[mM][sS][iI])(?:[?#].*)?$"
        },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
      }
    }
  }
}
