{
  "name": "@adamkadaban/crucible",
  "version": "0.1.0-beta.0",
  "description": "Source-install beta for controlling isolated Windows analysis VMs from Linux MCP agents.",
  "author": "Adam Hassan",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adamkadaban/crucible.git"
  },
  "bugs": {
    "url": "https://github.com/Adamkadaban/crucible/issues"
  },
  "homepage": "https://github.com/Adamkadaban/crucible#readme",
  "keywords": [
    "mcp",
    "opencode",
    "windows",
    "qemu",
    "kvm",
    "malware-analysis",
    "debugging",
    "windbg",
    "cdb"
  ],
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.10.0"
  },
  "bin": {
    "crucible": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/cli.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/cli.js",
    "guest/provision",
    "schemas",
    "vendor/crucible-guest-agent.exe",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b packages/core packages/mcp-server packages/cli",
    "build:bundle": "node scripts/build-npm-bundle.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "crucible": "tsx --conditions=development packages/cli/src/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepack": "pnpm build:bundle && node scripts/assert-npm-vendor.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.check.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "undici": "^7.16.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "25.9.1",
    "esbuild": "^0.28.0",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.0",
    "vitest": "4.1.7"
  }
}
